# AuraSpa Backend - Environment Variables
# Copy this file to .env and update with your values

# ========================================
# DATABASE CONFIGURATION (MySQL/XAMPP)
# ========================================
MYSQL_PASSWORD=
# Leave empty if no password set for root user in XAMPP

# ========================================
# JWT CONFIGURATION
# ========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-environment-should-be-at-least-256-bits-12345
# Change this to a long random string in production
# Minimum 32 characters recommended
# Example: openssl rand -base64 32

# ========================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ========================================
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
# Note: Use Gmail App Password, NOT your regular Gmail password!
# 
# How to get Gmail App Password:
# 1. Enable 2-Step Verification on your Gmail account
# 2. Go to myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your device)
# 4. Generate and copy the 16-character password
# 5. Paste it here as MAIL_PASSWORD

# ========================================
# FRONTEND CONFIGURATION
# ========================================
FRONTEND_URL=http://localhost:5173
# Change this to your production frontend URL when deploying
# Examples:
#   Development: http://localhost:5173
#   Production: https://yourdomain.com

# ========================================
# APPLICATION CONFIGURATION
# ========================================
SPRING_PROFILES_ACTIVE=dev
# Options: dev, test, prod
# Use 'dev' for development with verbose logging
# Use 'prod' for production with minimal logging

# ========================================
# SERVER CONFIGURATION
# ========================================
SERVER_PORT=8080
# Default port for Spring Boot backend

# ========================================
# SECURITY SETTINGS
# ========================================
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=1
# Account is locked for 1 minute after 5 failed login attempts

# ========================================
# OPTIONAL: Cloud Database (Production)
# ========================================
# Uncomment and update for cloud database deployment
# MYSQL_HOST=your-cloud-db.mysql.database.azure.com
# MYSQL_PORT=3306
# MYSQL_DATABASE=auraspa_db
# MYSQL_USERNAME=admin@your-cloud-db
# MYSQL_PASSWORD=your-cloud-password

# ========================================
# OPTIONAL: Production Email Service
# ========================================
# Use SendGrid, AWS SES, or other services for production
# SENDGRID_API_KEY=your-sendgrid-key
# AWS_SES_REGION=us-east-1
